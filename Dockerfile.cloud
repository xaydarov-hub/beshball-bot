FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/backend/package.json packages/backend/
COPY packages/bot/package.json packages/bot/
COPY packages/admin/package.json packages/admin/
RUN npm ci
COPY packages ./packages
COPY scripts ./scripts
COPY tsconfig.base.json ./
RUN npm run prisma:generate && npm run build
ENV NODE_ENV=production HOST=0.0.0.0 SERVE_ADMIN=true OCR_ENGINE=native WORKER_CONCURRENCY=1 OMP_THREAD_LIMIT=1
USER node
EXPOSE 10000
CMD ["node", "scripts/start-cloud.mjs"]
