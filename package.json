{
  "name": "beshball",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/bot",
    "packages/admin"
  ],
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "status": "node scripts/status-local.mjs",
    "test:shared": "npm run test --workspace=@beshball/shared",
    "typecheck": "npm run build -w @beshball/shared && npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @beshball/shared && npm run build -w @beshball/backend && npm run build -w @beshball/bot && npm run build -w @beshball/admin",
    "dev:backend": "npm run dev --workspace=@beshball/backend",
    "dev:bot": "npm run dev --workspace=@beshball/bot",
    "dev:admin": "npm run dev --workspace=@beshball/admin",
    "prisma:migrate": "npm run prisma:migrate --workspace=@beshball/backend",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint packages scripts --max-warnings=0",
    "test": "tsx --test packages/backend/test/*.test.ts packages/shared/test/*.spec.ts packages/shared/test/*.test.ts packages/bot/test/*.test.ts",
    "test:legacy": "npm run test:shared && npm run test -w @beshball/backend",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "tsx scripts/e2e-local.ts",
    "prisma:generate": "npm run prisma:generate -w @beshball/backend",
    "dev:worker": "npm run worker -w @beshball/backend",
    "zip": "node scripts/build-zip.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"scripts/*.{ts,mjs}\""
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.1",
    "archiver": "7.0.1",
    "pg": "8.16.3",
    "@types/pg": "8.15.6",
    "prettier": "3.6.2",
    "@playwright/test": "1.58.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "vite": {
      ".": "6.4.3",
      "esbuild": "0.25.12"
    },
    "tsx": {
      "esbuild": "0.28.1"
    }
  },
  "type": "module"
}
