# Copy to .env, use scripts/setup-local.mjs to generate strong local secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://beshball:SET_PASSWORD@localhost:5432/beshball
REDIS_URL=redis://localhost:6379
BOT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SEND_ENABLED=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
SUPER_ADMIN_TELEGRAM_IDS=
BACKEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
# Browser-accessible S3 endpoint for short-lived image links.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=beshball-receipts
S3_REGION=us-east-1
# Optional cloud alternative to S3 credentials (server-side only).
STORAGE_PROVIDER=s3
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_KEY=
OCR_LANGUAGES=eng+rus
OCR_ENGINE=native
# For optional Windows WebAssembly OCR, use an absolute local traineddata folder.
OCR_LANG_PATH=
ZIMZIM_API_BASE_URL=
ZIMZIM_API_KEY=
